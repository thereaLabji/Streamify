{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamify-public-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamify-status",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://thereaLabji.github.io",
    "HEARTBEAT_TTL_SECONDS": "90"
  }
}
